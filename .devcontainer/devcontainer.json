{
  "name": "devcontainer",
  "image": "rakirahman.azurecr.io/devcontainer/spark:f641c78eeffff2553ae7b7dcc46ccc9e67f48971b0bfe950afa91beac94850a1",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--device=/dev/fuse",
    "--security-opt=apparmor:unconfined",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "mounts": ["type=bind,source=/dev/fuse,target=/dev/fuse"]
}
