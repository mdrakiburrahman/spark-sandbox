{
  "name": "spark-scala",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/spark-scala",
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": ["build-jar"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [
          {
            "command": "echo 'All builds completed.'",
            "forwardAllArgs": false
          }
        ]
      },
      "outputs": ["{projectRoot}/**/*.jar"]
    },
    "build-jar": {
      "cache": true,
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [
          {
            "command": "sbt -J-Xmx16G -J-Xms4G -J-Xss6M -J-XX:+UseG1GC -J-XX:MaxMetaspaceSize=2048M assembly",
            "forwardAllArgs": false
          }
        ]
      },
      "inputs": [
        "{projectRoot}/**/*.scala",
        "{projectRoot}/**/*.sbt",
        "{projectRoot}/**/*.yaml",
        {
          "runtime": "git rev-parse --short HEAD"
        }
      ],
      "outputs": ["{projectRoot}/**/*.jar"]
    },
    "compile": {
      "cache": true,
      "dependsOn": ["compile-scala"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [
          {
            "command": "echo 'All compilations completed.'",
            "forwardAllArgs": false
          }
        ]
      },
      "outputs": ["{projectRoot}/**/*.jar"]
    },
    "compile-scala": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": ["sbt test:compile", "sbt compile", "sbt bloopInstall"],
        "parallel": false
      },
      "inputs": [
        "{projectRoot}/**/*.scala",
        "{projectRoot}/**/*.sbt",
        "{projectRoot}/**/*.yaml"
      ]
    },
    "clean": {
      "cache": false,
      "dependsOn": [
        "clean-livy",
        "metastore-down",
        "unmount-onelake",
        "imds-router-down"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [
          {
            "command": "sbt clean",
            "forwardAllArgs": false
          },
          {
            "command": "rm -rf ~/.ivy2 out test-reports test.log *.log .logs .temp spark-warehouse checkpoints* warehouse*",
            "forwardAllArgs": false
          },
          {
            "command": "bash -c 'source .scripts/run-livy.sh && kill_all_sessions'",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "clean-livy": {
      "cache": false,
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [
          {
            "command": "bash -c 'source .scripts/run-livy.sh && kill_all_sessions'",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "lint": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": ["sbt scalafmtAll"],
        "parallel": false
      },
      "dependsOn": [],
      "inputs": ["{projectRoot}/**/*.scala", "{projectRoot}/**/*.sbt"],
      "outputs": ["{projectRoot}/**/*.scala", "{projectRoot}/**/*.sbt"]
    },
    "run": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["build-jar", "metastore-up", "pre-cache-ivy"],
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": {}
      },
      "options": {
        "cwd": "projects/spark-scala",
        "JOB": "all",
        "commands": [
          {
            "command": ".scripts/run-spark-jobs.sh {args.JOB}",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["test-scala", "test-jest"],
      "options": {
        "commands": ["echo 'All tests completed.'"]
      }
    },
    "test-jest": {
      "cache": false,
      "dependsOn": [
        "build-jar",
        "metastore-up",
        "mount-onelake",
        "pre-cache-ivy"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "npx jest --config jest.config.js --verbose --bail",
        "cwd": "projects/spark-scala"
      }
    },
    "test-scala": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "env": {
          "JAVA_HOME": "/usr/local/sdkman/candidates/java/current"
        },
        "commands": [
          {
            "command": "sbt coverage test coverageReport",
            "forwardAllArgs": false
          },
          {
            "command": "npx tsx tools/scripts/print-coverage.ts",
            "forwardAllArgs": false
          }
        ],
        "parallel": false
      },
      "inputs": [
        "{projectRoot}/**/*.scala",
        "{projectRoot}/**/*.sbt",
        "{projectRoot}/**/*.yaml"
      ],
      "outputs": ["{projectRoot}/**/scoverage-report/**"]
    },
    "get-azcopy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [".scripts/get-azcopy.sh ~/.azure/bin"],
        "parallel": false
      }
    },
    "refresh-az-login": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [".scripts/refresh-az-login.sh"],
        "parallel": false
      }
    },
    "imds-router-up": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [".scripts/imds-router.sh"],
        "parallel": false
      }
    },
    "imds-router-down": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "command": "fuser -k -TERM 6020/tcp 2>/dev/null || true"
      }
    },
    "mount-onelake": {
      "dependsOn": ["refresh-az-login", "imds-router-up"],
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [".scripts/mount-onelake.sh mount"],
        "parallel": false
      }
    },
    "unmount-onelake": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [".scripts/mount-onelake.sh unmount"],
        "parallel": false
      }
    },
    "init": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["metastore-up", "pre-cache-ivy"],
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": {}
      },
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [
          "npx nx run spark-scala:mount-onelake --verbose --output-style=stream",
          "npx nx run spark-scala:run --JOB='delta-mount' --verbose --output-style=stream"
        ],
        "parallel": false
      }
    },
    "metastore-up": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [".scripts/init-metastore.sh"],
        "parallel": false
      }
    },
    "metastore-down": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [
          "docker compose -f ../../docker/Compose.sqlserver.metastore.yaml down --volumes --remove-orphans"
        ]
      }
    },
    "pre-cache-ivy": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-scala",
        "commands": [".scripts/pre-cache-ivy.sh"],
        "parallel": false
      }
    }
  }
}
