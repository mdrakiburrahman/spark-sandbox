//--configured at schema: spark_catalog.dbt_adventureworks_dwh
Table fct_sales {
  "sales_key" "unknown" [pk, note: "The surrogate key of the fct sales"]
  "salesorderid" "unknown" [note: "The natural key of the saleorderheader"]
  "salesorderdetailid" "unknown" [note: "The natural key of the salesorderdetail"]
  "product_key" "unknown" [note: "The foreign key of the product"]
  "customer_key" "unknown" [note: "The foreign key of the customer"]
  "ship_address_key" "unknown" [note: "The foreign key of the shipping address"]
  "creditcard_key" "unknown" [note: "The foreign key of the creditcard. If no creditcard exists, it was assumed that purchase was made in cash."]
  "order_date_key" "unknown" [note: "The foreign key of the order date"]
  "order_status_key" "unknown" [note: "The foreign key of the order status"]
  "unitprice" "unknown" [note: "The unit price of the product"]
  "orderqty" "unknown" [note: "The quantity of the product"]
  "revenue" "unknown" [note: "The revenue obtained by multiplying unitprice and orderqty"]

}
//--configured at schema: spark_catalog.dbt_adventureworks_dwh
Table obt_sales {
  "sales_key" "unknown" [pk, note: "The surrogate key of the fct sales"]
  "salesorderid" "unknown" [note: "The natural key of the saleorderheader"]
  "salesorderdetailid" "unknown" [note: "The natural key of the salesorderdetail"]
  "unitprice" "unknown" [note: "The unit price of the product"]
  "orderqty" "unknown" [note: "The quantity of the product"]
  "revenue" "unknown" [note: "The revenue obtained by multiplying unitprice and orderqty"]

}
