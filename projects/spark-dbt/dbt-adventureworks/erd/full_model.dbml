//Refs (based on the DBT Relationship Tests)
Ref: fct_sales."creditcard_key" > dim_credit_card."creditcard_key"
Ref: fct_sales."customer_key" > dim_customer."customer_key"
Ref: fct_sales."order_date_key" > dim_date."date_key"
Ref: fct_sales."order_status_key" > dim_order_status."order_status_key"
Ref: fct_sales."product_key" > dim_product."product_key"
Ref: fct_sales."ship_address_key" > dim_address."address_key"


//Refs (based on the Source Relationship Tests)
Ref: address."stateprovinceid" > stateprovince."stateprovinceid"
Ref: customer."personid" > person."businessentityid"
Ref: customer."storeid" > store."businessentityid"
Ref: product."productsubcategoryid" > productsubcategory."productsubcategoryid"
Ref: productsubcategory."productcategoryid" > productcategory."productcategoryid"
Ref: salesorderdetail."productid" > product."productid"
Ref: salesorderdetail."salesorderid" > salesorderheader."salesorderid"
Ref: salesorderheader."billtoaddressid" > address."addressid"
Ref: salesorderheader."creditcardid" > creditcard."creditcardid"
Ref: salesorderheader."customerid" > customer."customerid"
Ref: salesorderheader."shiptoaddressid" > address."addressid"
Ref: salesorderheadersalesreason."salesorderid" > salesorderheader."salesorderid"
Ref: salesorderheadersalesreason."salesreasonid" > salesreason."salesreasonid"
Ref: stateprovince."countryregioncode" > countryregion."countryregioncode"