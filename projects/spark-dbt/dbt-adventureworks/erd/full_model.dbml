//--configured at schema: spark_catalog.dbt_adventureworks_dwh
Table fct_sales {
  "sales_key" "string" [note: "The surrogate key of the fct sales"]
  "product_key" "string" [note: "The foreign key of the product"]
  "customer_key" "string" [note: "The foreign key of the customer"]
  "creditcard_key" "string" [note: "The foreign key of the creditcard. If no creditcard exists, it was assumed that purchase was made in cash."]
  "ship_address_key" "string" [note: "The foreign key of the shipping address"]
  "order_status_key" "string" [note: "The foreign key of the order status"]
  "order_date_key" "string" [note: "The foreign key of the order date"]
  "salesorderid" "int" [note: "The natural key of the saleorderheader"]
  "salesorderdetailid" "int" [note: "The natural key of the salesorderdetail"]
  "unitprice" "decimal(10,0)" [note: "The unit price of the product"]
  "orderqty" "smallint" [note: "The quantity of the product"]
  "revenue" "decimal(16,0)" [note: "The revenue obtained by multiplying unitprice and orderqty"]

  Note: ""
}
