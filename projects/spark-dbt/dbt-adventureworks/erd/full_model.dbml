  "customerid" "unknown" [pk, note: "The natural key of the customer"]
  "fullname" "unknown" [note: "The customer name. Adopted as customer_fullname when person name is not null."]
  "businessentityid" "unknown"
  "storebusinessentityid" "unknown"
  "storename" "unknown" [note: "The store name."]

}
