Ref: fct_delta_health."most_common_operation_key" > dim_delta_table_operation_type."operation_type_key"
Ref: fct_delta_health."overall_status_key" > dim_delta_table_health_status."health_status_key"
Ref: fct_delta_health."table_key" > dim_delta_table."__pk"
