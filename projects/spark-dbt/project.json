{
  "name": "spark-dbt",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-dbt",
        "commands": [
          "if [ -n \"$HATCH_ENV\" ]; then echo 'ERROR: Exit hatch shell first (type: exit)' && exit 1; fi",
          "hatch env remove default 2>/dev/null || true",
          "hatch env prune 2>/dev/null || true",
          "cat .cleanpaths | xargs rm -rf"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["black --line-length 2000 ."],
        "parallel": false
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "dependsOn": ["clean"],
      "options": {
        "cwd": "projects/spark-dbt",
        "commands": ["hatch env create"],
        "parallel": false
      }
    },
    "init": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "init",
          "projects": ["spark-scala"]
        },
        "install"
      ],
      "options": {
        "cwd": "projects/spark-dbt",
        "commands": [
          {
            "command": "echo 'Initialization completed.'",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-dbt",
        "PROJECT": "dbt-jaffle-shop",
        "TARGET": "local-local",
        "commands": [
          {
            "command": ".scripts/run-dbt-local.sh {args.PROJECT} {args.TARGET}",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "package": {
      "dependsOn": ["install"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-dbt",
        "commands": [".scripts/package-fabric.sh"]
      }
    },
    "compile": {
      "dependsOn": ["install"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-dbt",
        "commands": [".scripts/compile-erd.sh"]
      }
    },
    "test": {
      "dependsOn": ["init"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "projects/spark-dbt",
        "commands": [
          "npx nx run spark-dbt:run --PROJECT=dbt-jaffle-shop --TARGET=local-local --verbose --output-style=stream",
          "npx nx run spark-dbt:run --PROJECT=dbt-adventureworks --TARGET=local-local --verbose --output-style=stream",
          "npx nx run spark-dbt:run --PROJECT=dbt-dataops --TARGET=local-local --verbose --output-style=stream"
        ],
        "parallel": true
      }
    }
  }
}
