//Tables (based on the selection criteria)
//--configured at schema: spark_catalog.dbt_jaffle_shop_dwh
Table customers {
  "customer_id" "unknown" [pk, note: "This is a unique identifier for a customer"]
  "first_name" "unknown" [note: "Customer's first name. PII."]
  "last_name" "unknown" [note: "Customer's last name. PII."]
  "first_order" "unknown" [note: "Date (UTC) of a customer's first order"]
  "most_recent_order" "unknown" [note: "Date (UTC) of a customer's most recent order"]
  "number_of_orders" "unknown" [note: "Count of the number of orders a customer has placed"]
  "total_order_amount" "unknown" [note: "Total value (AUD) of a customer's orders"]

  Note: "This table has basic information about a customer, as well as some derived facts based on a customer's orders"
}
//--configured at schema: spark_catalog.dbt_jaffle_shop_dwh
Table orders {
  "order_id" "unknown" [pk, note: "This is a unique identifier for an order"]
  "customer_id" "unknown" [note: "Foreign key to the customers table"]
  "order_date" "unknown" [note: "Date (UTC) that the order was placed"]
  "status" "unknown" [note: "Orders can be one of the following statuses:\n\n| status         | description                                                                                                            |\n| -------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| placed         | The order has been placed but has not yet left the warehouse                                                           |\n| shipped        | The order has ben shipped to the customer and is currently in transit                                                  |\n| completed      | The order has been received by the customer                                                                            |\n| return_pending | The customer has indicated that they would like to return the order, but it has not yet been received at the warehouse |\n| returned       | The order has been returned by the customer and received at the warehouse                                              |"]
  "amount" "unknown" [note: "Total amount (AUD) of the order"]
  "credit_card_amount" "unknown" [note: "Amount of the order (AUD) paid for by credit card"]
  "coupon_amount" "unknown" [note: "Amount of the order (AUD) paid for by coupon"]
  "bank_transfer_amount" "unknown" [note: "Amount of the order (AUD) paid for by bank transfer"]
  "gift_card_amount" "unknown" [note: "Amount of the order (AUD) paid for by gift card"]

  Note: "This table has basic information about orders, as well as some derived facts based on payments"
}
//--configured at schema: spark_catalog.dbt_jaffle_shop_dwh
Table stg_customers {
  "customer_id" "unknown" [pk]

}
//--configured at schema: spark_catalog.dbt_jaffle_shop_dwh
Table stg_orders {
  "order_id" "unknown" [pk]
  "status" "unknown"
  "customer_id" "unknown"

}
//--configured at schema: spark_catalog.dbt_jaffle_shop_dwh
Table stg_payments {
  "payment_id" "unknown" [pk]
  "payment_method" "unknown"
  "order_id" "unknown"

}
//--configured at schema: spark_catalog.dbt_jaffle_shop_seed
Table raw_customers {
  "id" "bigint" [pk]
  "first_name" "string"
  "last_name" "string"

}
//--configured at schema: spark_catalog.dbt_jaffle_shop_seed
Table raw_orders {
  "id" "bigint" [pk]
  "user_id" "bigint"
  "order_date" "date"
  "status" "string"

}
//--configured at schema: spark_catalog.dbt_jaffle_shop_seed
Table raw_payments {
  "id" "bigint" [pk]
  "order_id" "bigint"
  "payment_method" "string"
  "amount" "bigint"

}
//Refs (based on the DBT Relationship Tests)
Ref: orders."customer_id" > customers."customer_id"
Ref: raw_orders."user_id" > raw_customers."id"
Ref: raw_payments."order_id" > raw_orders."id"
Ref: stg_orders."customer_id" > stg_customers."customer_id"
Ref: stg_payments."order_id" > stg_orders."order_id"
