// ============================================================
// <project-name> — Kimball STAR Schema Design
//
// Authored by the kimball-dbml skill. This is the design spec.
//
// Conventions:
//   - snake_case everywhere
//   - {{META:NATURAL_KEY}} marks the source-system business identifier
//   - {{META:SCD2}}        marks attributes tracked over time
//   - {{META:ROLE_PLAYED}} marks a FK that plays multiple roles for the same dim
//   - {{META:DEGENERATE}}  marks a degenerate dimension on a fact
//   - Every dim has an unknown-member row at <entity>_key = -1
//   - Every SCD2 dim has row_effective_start, row_effective_end, is_row_effective
//
// Render: paste into https://dbdiagram.io to see the ERD.
// Docs:   https://dbml.dbdiagram.io/docs/
// Companion guidelines: ../../KIMBALL_GUIDELINES.md
// ============================================================

// ============================================================
// Conformed Dimensions
// (shared across multiple facts — keep at top)
// ============================================================

Table dim_date {
    Note: 'One row per calendar date. SCD0 (immutable). Unknown member at date_key = -1.'
    date_key           varchar [primary key, note: '{{META:NATURAL_KEY}} yyyymmdd as a string']
    date               date
    day                integer
    day_of_week        integer
    day_of_week_name   varchar
    month              integer
    month_name         varchar
    quarter            integer
    year               integer
    first_day_of_month date
    last_day_of_month  date
    is_weekend         bool
}

// TODO: Add other conformed dimensions here (e.g. dim_customer, dim_user, dim_product).

