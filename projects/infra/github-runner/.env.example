# GitHub repo URL the runner registers against. The runner registration token
# is auto-minted by .scripts/deploy-gh-runner.sh via `gh api`, so an
# authenticated `gh auth login` is the only GitHub credential you need.
GH_REPO=https://github.com/mdrakiburrahman/spark-sandbox

# Azure subscription + resource group for the runner stack.
TF_RESOURCE_GROUP=gh-ivm-bench-rg
TF_SUBSCRIPTION_ID=

# Runner configuration
TF_VAR_location=canadacentral
TF_VAR_instance_sku=Standard_E32as_v5
TF_VAR_instance_count=2

# Terraform state backend (Azure Storage)
TF_STATE_STORAGE_ACCOUNT_NAME=rakirahman
TF_STATE_STORAGE_ACCOUNT_CONTAINER=tfstate
TF_STATE_STORAGE_ACCOUNT_KEY=
