                    "purpose": "Default permission."
                  }
                ]
              },
              {
                "type": "SQLEndpoint",
                "displayName": "dbt_jaffle_shop_seed",
                "detail": [
                  {
                    "permissions": 7,
                    "artifactPermissions": 7,
                    "objectId": "{user-oid}",
                    "purpose": "Default permission."
                  }
                ]
              },
              {
                "type": "Lakehouse",
                "displayName": "dbt_jaffle_shop_seed",
                "detail": [
                  {
                    "permissions": 71,
                    "artifactPermissions": 15,
                    "objectId": "{user-oid}",
                    "purpose": "Default permission."
                  }
                ]
              }
            ]
          },
