table fct_sales
	lineageTag: a84e91c8-134e-4bfe-9ba5-bb0f2daed9dc
	sourceLineageTag: [dbo].[fct_sales]

	/// Sum of all revenue
	measure 'Total Revenue' = SUM(fct_sales[revenue])
		formatString: $#,##0
		displayFolder: Revenue
		lineageTag: cdf0c6dc-8505-4d3e-8b18-499c80060595

	/// Sum of all order quantities
	measure 'Total Quantity' = SUM(fct_sales[orderqty])
		formatString: #,##0
		displayFolder: Quantity
		lineageTag: 42594cd0-2f0b-45d7-a5fc-f2328a0ba847

	/// Average unit price across all line items
	measure 'Avg Unit Price' = AVERAGE(fct_sales[unitprice])
		formatString: $#,##0.00
		displayFolder: Pricing
		lineageTag: 5ca966b7-5dcf-48dc-8623-953f1ed53daf

	/// Average revenue per distinct sales order
	measure 'Avg Revenue per Order' = DIVIDE([Total Revenue], [Total Orders], 0)
		formatString: $#,##0.00
		displayFolder: Revenue
		lineageTag: 05516ae1-306a-4fcb-993d-d0584bcd706f

	/// Count of distinct sales orders
	measure 'Total Orders' = DISTINCTCOUNT(fct_sales[salesorderid])
		formatString: #,##0
		displayFolder: Orders
		lineageTag: 973f2371-a71f-4f05-8d5c-162f612baafb

	/// Count of all order line items (rows in the fact table)
	measure 'Total Order Lines' = COUNTROWS(fct_sales)
		formatString: #,##0
		displayFolder: Orders
		lineageTag: 53777e35-58f3-498d-a7f4-caab69c86cfc

	/// Average quantity per distinct sales order
	measure 'Avg Qty per Order' = DIVIDE([Total Quantity], [Total Orders], 0)
		formatString: #,##0.00
		displayFolder: Quantity
		lineageTag: d948b0ea-bca7-4e0c-9bd6-ac4848d4a18f

	/// Year-to-date total revenue
	measure 'Revenue YTD' = TOTALYTD([Total Revenue], dim_date[date_day])
		formatString: $#,##0
		displayFolder: Revenue
		lineageTag: b52bde55-1e44-45e3-9f78-0d08c2ec25f1

	/// Total revenue for the same period in the prior year
	measure 'Revenue Prior Year' = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[date_day]))
		formatString: $#,##0
		displayFolder: Revenue
		lineageTag: d32843cc-2c66-475c-9af3-b19afceb8f1a

	/// Year-over-year revenue growth percentage
	measure 'Revenue YoY %' = VAR _current = [Total Revenue] VAR _prior = [Revenue Prior Year] RETURN DIVIDE(_current - _prior, _prior, BLANK())
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: f29df46c-3075-49cd-88c2-4a526bf41128

