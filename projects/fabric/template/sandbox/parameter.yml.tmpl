# ===============================================================================
# https://microsoft.github.io/fabric-cicd/0.1.7/how_to/parameterization/
# ===============================================================================

spark_pool:
  - instance_pool_id: "00000000-0000-0000-0000-000000000001"
    replace_value:
      "mdrrahman":
        type: "Workspace"
        name: "smallOne35"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#
#   * "find_value" represents the 'prod' env id.
#     Replace with your '{unique-env-id}' to override.
#     Leave it as is to point your workspace to the
#     'prod' env.
#
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
find_replace:
  - find_value: \#\s*META\s+"default_lakehouse":\s*"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})"
    replace_value:
      "mdrrahman": "$items.Lakehouse.dbt_adventureworks_seed.id"
    is_regex: "true"
    file_path: "/dbt_scheduler.Notebook/notebook-content.py"

  - find_value: \#\s*META\s+"default_lakehouse_workspace_id":\s*"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})"
    replace_value:
      "mdrrahman": "$workspace.id"
    is_regex: "true"
    file_path: "/dbt_scheduler.Notebook/notebook-content.py"
